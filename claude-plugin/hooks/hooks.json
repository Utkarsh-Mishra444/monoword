{
  "description": "Monoword mode: style notes on every prompt while the mode is on; each finished reply played one word at a time above the prompt (terminal mode, the band.mjs mod) or opened in the Monoword app (app mode).",
  "modules": [
    "./band.mjs"
  ],
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/scripts/prompt-hook.sh\"",
            "timeout": 10,
            "statusMessage": "Monoword style"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/scripts/stop-hook.sh\"",
            "timeout": 20,
            "statusMessage": "Saving the reply for Monoword"
          }
        ]
      }
    ]
  }
}
